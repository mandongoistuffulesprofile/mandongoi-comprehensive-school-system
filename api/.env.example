NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgres://user:password@host:5432/school_db

# JWT
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRY=7d

# ── M-Pesa Daraja Integration ──
# Step 1: Create a company account at https://developer.safaricom.co.ke
# Step 2: Create an App and add API products: C2B + Lipa Na M-Pesa Online (STK Push)
# Step 3: Set sandbox credentials below (found in your app's Sandbox section)
# Step 4: Test with the simulate endpoint (see README)
# Step 5: Submit Go-Live request with your production Paybill number

# Sandbox defaults (from Safaricom developer portal):
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-passkey
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox  # switch to 'production' after Go-Live approval

# Callback URL must be public HTTPS in production.
# For sandbox testing, use a tunnel like ngrok (https://ngrok.com):
#   ngrok http 4000
# Then set MPESA_CALLBACK_URL=https://your-ngrok-id.ngrok.io/api/invoices/mpesa/webhook
MPESA_CALLBACK_URL=https://your-domain.com/api/invoices/mpesa/webhook

# ── Simulate a payment in sandbox (no real money) ──
# After starting the server, run:
#   curl -X POST http://localhost:4000/api/invoices/mpesa/simulate \
#     -H "Authorization: Bearer YOUR_TOKEN" \
#     -H "Content-Type: application/json" \
#     -d '{"amount":500,"phone":"254712345678","accountRef":"JohnDoe-Grade4"}'

# ── SMS Provider — Advanta Africa ──
SMS_API_KEY=your-advanta-api-key
SMS_SENDER_ID=your-sender-id
SMS_PARTNER_ID=your-partner-id
SMS_API_URL=https://quicksms.advantasms.com/api/services/sendsms/

# ── Error Monitoring (Sentry) — optional, set empty to disable ──
# Get a DSN at https://sentry.io (free tier available)
SENTRY_DSN=
